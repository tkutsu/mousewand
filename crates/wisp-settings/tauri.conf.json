{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wisp-settings",
  "identifier": "io.github.tkutsu.wisp",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "wisp settings",
        "width": 920,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
